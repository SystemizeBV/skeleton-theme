{% liquid
  # The `t` filter HTML-escapes its output, so raw setting branches are escaped
  # here and the localized variables are printed without a second escape.
  assign benefits_label = section.settings.accessibility_label | escape
  if section.settings.accessibility_label == 'Shopping benefits'
    assign benefits_label = 'sections.home.benefits_label' | t
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block-start: 0;
  }
{% endstyle %}

<section class="loemies-benefits full-width" aria-label="{{ benefits_label }}">
  <ul class="loemies-benefits__list" role="list">
    {% for block in section.blocks %}
      {% liquid
        # The `t` filter HTML-escapes its output, so escape the raw branches here
        # and print `benefit_heading`/`benefit_text` without a second escape.
        assign benefit_heading = block.settings.heading | escape
        assign benefit_text = block.settings.text | escape

        if section.settings.use_store_promises
          case block.settings.icon
            when 'shipping'
              if settings.free_shipping_enabled
                assign benefit_heading = 'sections.promises.free_shipping' | t: threshold: settings.free_shipping_threshold
                assign benefit_text = 'sections.promises.shipping_detail' | t: threshold: settings.free_shipping_threshold
              else
                assign benefit_heading = 'sections.promises.tracked_shipping' | t
                assign benefit_text = 'sections.promises.tracked_shipping_detail' | t
              endif
            when 'return'
              assign benefit_heading = 'sections.promises.returns' | t: days: settings.return_window_days
              assign benefit_text = 'sections.promises.returns_detail' | t: days: settings.return_window_days
            when 'payment'
              assign benefit_heading = 'sections.promises.secure_payment' | t
              assign benefit_text = 'sections.promises.payment_detail' | t
            when 'care'
              assign benefit_heading = 'sections.promises.curated' | t
              assign benefit_text = 'sections.promises.curated_detail' | t
          endcase
        endif
      %}
      <li class="loemies-benefit" style="--loemies-benefit-color: {{ block.settings.background_color }};" {{ block.shopify_attributes }}>
        <span class="loemies-benefit__icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'return' %}
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M8 7H4v-4M4.5 7.5A8 8 0 1 1 4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% when 'payment' %}
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="M3 9h18M7 15h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            {% when 'care' %}
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 21s8-4.6 8-11a4.5 4.5 0 0 0-8-2.8A4.5 4.5 0 0 0 4 10c0 6.4 8 11 8 11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/>
              </svg>
          {% endcase %}
        </span>
        <span class="loemies-benefit__copy">
          <strong>{{ benefit_heading }}</strong>
          <span>{{ benefit_text }}</span>
        </span>
      </li>
    {% endfor %}
  </ul>
</section>


{% schema %}
{
  "name": "Loemies benefits",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Shopping benefits"
    },
    {
      "type": "checkbox",
      "id": "use_store_promises",
      "label": "Use global store promises",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "payment", "label": "Payment" },
            { "value": "care", "label": "Care" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Tracked EU delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Tracking included with every parcel"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background",
          "default": "#F7DC8D"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loemies benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "shipping", "heading": "Tracked EU delivery", "text": "Tracking included with every parcel", "background_color": "#F7DC8D" } },
        { "type": "benefit", "settings": { "icon": "return", "heading": "30-day returns", "text": "Simple, clearly explained returns", "background_color": "#C4E4C9" } },
        { "type": "benefit", "settings": { "icon": "payment", "heading": "Secure payment", "text": "Available methods shown at checkout", "background_color": "#BEDCF1" } },
        { "type": "benefit", "settings": { "icon": "care", "heading": "Thoughtfully selected", "text": "Chosen for purposeful everyday play", "background_color": "#F5C8CF" } }
      ]
    }
  ]
}
{% endschema %}
