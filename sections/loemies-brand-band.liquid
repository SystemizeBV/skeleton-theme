{% liquid
  # The `t` filter HTML-escapes its output, so raw setting branches are escaped
  # here and the localized variables are printed without a second escape.
  assign band_eyebrow = section.settings.eyebrow | escape
  assign band_heading = section.settings.heading | escape
  assign band_text = section.settings.text
  assign band_button = section.settings.button_label | escape
  if section.settings.eyebrow == 'Our approach'
    assign band_eyebrow = 'sections.home.brand.eyebrow' | t
  endif
  if section.settings.heading == 'Less choice. Better explained.'
    assign band_heading = 'sections.home.brand.heading' | t
  endif
  if band_text == '<p>A considered toy collection that makes age, materials and ways to play easier to compare.</p>'
    capture band_text
      echo '<p>'
      echo 'sections.home.brand.text' | t
      echo '</p>'
    endcapture
  endif
  if section.settings.button_label == 'Ask about a product'
    assign band_button = 'sections.home.brand.button' | t
  endif
%}

<section
  class="loemies-brand-band full-width"
  style="--loemies-band-background: {{ section.settings.background_color }}; --loemies-band-accent: {{ section.settings.accent_color }};"
  aria-labelledby="LoemiesBand-{{ section.id }}"
>
  <div class="loemies-brand-band__inner">
    <div class="loemies-brand-band__intro">
      {% if band_eyebrow != blank %}
        <p class="loemies-brand-band__eyebrow">{{ band_eyebrow }}</p>
      {% endif %}
      <h2 id="LoemiesBand-{{ section.id }}">{{ band_heading }}</h2>
      {% if band_text != blank %}
        <div class="loemies-brand-band__text">{{ band_text }}</div>
      {% endif %}
      {% if band_button != blank and section.settings.button_link != blank %}
        <a class="loemies-brand-band__action" href="{{ section.settings.button_link }}">
          {{ band_button }}
        </a>
      {% endif %}
    </div>

    <div class="loemies-brand-band__reasons">
      {% for block in section.blocks %}
        {% liquid
          # The `t` filter HTML-escapes its output, so escape the raw branches here
          # and print `reason_heading`/`reason_text` without a second escape.
          assign reason_heading = block.settings.heading | escape
          assign reason_text = block.settings.text | escape
          case block.settings.heading
            when 'Useful details first'
              assign reason_heading = 'sections.home.brand.details_heading' | t
              if block.settings.text == 'See age, materials and play style at a glance when available.'
                assign reason_text = 'sections.home.brand.details_text' | t
              endif
            when 'A smaller edit'
              assign reason_heading = 'sections.home.brand.edit_heading' | t
              if block.settings.text == 'A focused range makes it easier to compare and choose.'
                assign reason_text = 'sections.home.brand.edit_text' | t
              endif
            when 'Questions welcomed'
              assign reason_heading = 'sections.home.brand.questions_heading' | t
              if block.settings.text == 'Ask us about a product before you decide — we are happy to help.'
                assign reason_text = 'sections.home.brand.questions_text' | t
              endif
          endcase
        %}
        <article {{ block.shopify_attributes }}>
          <span class="loemies-brand-band__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'delivery' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/></svg>
              {% when 'service' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 17c-1.7 0-3-1.3-3-3v-3a10 10 0 0 1 20 0v3c0 1.7-1.3 3-3 3h-2v-7h5M2 10h5v7H5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 19c-1 1-2.7 1.5-5 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              {% when 'selection' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 20 6v5c0 5.2-3.2 8.4-8 10-4.8-1.6-8-4.8-8-10V6l8-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endcase %}
          </span>
          <h3>{{ reason_heading }}</h3>
          <p>{{ reason_text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Loemies brand promise",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Loemies"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How we choose the collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A smaller, considered range with clear product information and room for real play.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "More about us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2F6B4F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow",
      "default": "#F7DC8D"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "safety",
          "options": [
            { "value": "safety", "label": "Safety" },
            { "value": "selection", "label": "Selection" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "service", "label": "Service" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Clear product guidance"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Useful information stays visible so families can choose with context."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loemies brand promise",
      "blocks": [
        { "type": "reason", "settings": { "icon": "safety", "heading": "Clear age guidance", "text": "Maker recommendations stay visible so you can choose with context." } },
        { "type": "reason", "settings": { "icon": "safety", "heading": "Purposeful play", "text": "We favor toys that invite imagination, movement and repeat play." } },
        { "type": "reason", "settings": { "icon": "service", "heading": "Questions welcomed", "text": "Ask us about a product before you decide — we are happy to help." } }
      ]
    }
  ]
}
{% endschema %}
