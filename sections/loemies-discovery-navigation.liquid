{% liquid
  # The `t` filter HTML-escapes its output, so raw setting branches are escaped
  # here and the localized variables are printed without a second escape.
  assign discovery_eyebrow = section.settings.eyebrow | escape
  assign discovery_heading = section.settings.heading | escape
  assign discovery_text = section.settings.text
  assign age_heading = section.settings.age_heading | escape
  assign age_note = section.settings.age_note | escape
  assign first_age_label = section.settings.first_age_label | escape
  assign second_age_label = section.settings.second_age_label | escape
  assign third_age_label = section.settings.third_age_label | escape
  assign fourth_age_label = section.settings.fourth_age_label
  assign play_heading = section.settings.play_heading | escape
  if section.settings.eyebrow == 'Find their kind of fun'
    assign discovery_eyebrow = 'sections.home.discovery.eyebrow' | t
  endif
  if section.settings.heading == 'Find the right toy'
    assign discovery_heading = 'sections.home.discovery.heading' | t
  endif
  if discovery_text == '<p>Start with a minimum age or the way they love to play.</p>'
    capture discovery_text
      echo '<p>'
      echo 'sections.home.discovery.text' | t
      echo '</p>'
    endcapture
  endif
  if section.settings.age_heading == 'Start with minimum age'
    assign age_heading = 'sections.home.discovery.age_heading' | t
  endif
  if section.settings.age_note == 'Always check the product page for the maker’s full recommendation.'
    assign age_note = 'sections.home.discovery.age_note' | t
  endif
  if section.settings.first_age_label == 'From 1 year'
    assign first_age_label = 'sections.home.discovery.first_age' | t
  endif
  if section.settings.second_age_label == 'From 2 years'
    assign second_age_label = 'sections.home.discovery.second_age' | t
  endif
  if section.settings.third_age_label == 'From 3 years'
    assign third_age_label = 'sections.home.discovery.third_age' | t
  endif
  if section.settings.play_heading == 'Choose a way to play'
    assign play_heading = 'sections.home.discovery.play_heading' | t
  endif
%}

<section class="loemies-discovery full-width" aria-labelledby="LoemiesDiscovery-{{ section.id }}">
  <div class="loemies-discovery__inner">
    <header class="loemies-discovery__header">
      {% if discovery_eyebrow != blank %}
        <p class="loemies-discovery__eyebrow">{{ discovery_eyebrow }}</p>
      {% endif %}
      <h2 id="LoemiesDiscovery-{{ section.id }}">{{ discovery_heading }}</h2>
      {% if discovery_text != blank %}
        <div class="loemies-discovery__text">{{ discovery_text }}</div>
      {% endif %}
    </header>

    <div class="loemies-discovery__groups">
      <div id="shop-by-age" class="loemies-discovery__group loemies-discovery__group--age">
        <div class="loemies-discovery__group-heading">
          <h3>{{ age_heading }}</h3>
          {% if age_note != blank %}<p>{{ age_note }}</p>{% endif %}
        </div>
        <nav class="loemies-discovery__age-links" aria-label="{{ age_heading }}">
          <a href="{{ section.settings.first_age_link | default: routes.all_products_collection_url }}" style="--discovery-card-color: {{ section.settings.first_age_color }};">
            <span aria-hidden="true">{{ section.settings.first_age_badge | escape }}</span>
            <strong>{{ first_age_label }}</strong>
            <span class="loemies-discovery__arrow" aria-hidden="true">&rsaquo;</span>
          </a>
          {% if second_age_label != blank %}
            <a href="{{ section.settings.second_age_link | default: routes.all_products_collection_url }}" style="--discovery-card-color: {{ section.settings.second_age_color }};">
              <span aria-hidden="true">{{ section.settings.second_age_badge | escape }}</span>
              <strong>{{ second_age_label }}</strong>
              <span class="loemies-discovery__arrow" aria-hidden="true">&rsaquo;</span>
            </a>
          {% endif %}
          {% if third_age_label != blank %}
            <a href="{{ section.settings.third_age_link | default: routes.all_products_collection_url }}" style="--discovery-card-color: {{ section.settings.third_age_color }};">
              <span aria-hidden="true">{{ section.settings.third_age_badge | escape }}</span>
              <strong>{{ third_age_label }}</strong>
              <span class="loemies-discovery__arrow" aria-hidden="true">&rsaquo;</span>
            </a>
          {% endif %}
          {% if fourth_age_label != blank %}
            <a href="{{ section.settings.fourth_age_link | default: routes.all_products_collection_url }}" style="--discovery-card-color: {{ section.settings.fourth_age_color }};">
              <span aria-hidden="true">{{ section.settings.fourth_age_badge | escape }}</span>
              <strong>{{ fourth_age_label | escape }}</strong>
              <span class="loemies-discovery__arrow" aria-hidden="true">&rsaquo;</span>
            </a>
          {% endif %}
        </nav>
      </div>

      <div id="shop-by-play" class="loemies-discovery__group loemies-discovery__group--play">
        <div class="loemies-discovery__group-heading">
          <h3>{{ play_heading }}</h3>
        </div>
        <nav class="loemies-discovery__play-links" aria-label="{{ play_heading }}">
          {% for block in section.blocks %}
            {% liquid
              # The `t` filter HTML-escapes its output, so escape the raw branches here
              # and print `play_card_heading`/`play_card_text` without a second escape.
              assign play_card_heading = block.settings.heading | escape
              assign play_card_text = block.settings.text | escape
              case block.settings.heading
                when 'Fine-motor play'
                  assign play_card_heading = 'sections.home.discovery.fine_motor_heading' | t
                  if block.settings.text == 'Threading, sorting and building'
                    assign play_card_text = 'sections.home.discovery.fine_motor_text' | t
                  endif
                when 'Sensory play'
                  assign play_card_heading = 'sections.home.discovery.sensory_heading' | t
                  if block.settings.text == 'Touch, movement and discovery'
                    assign play_card_text = 'sections.home.discovery.sensory_text' | t
                  endif
                when 'Pretend play'
                  assign play_card_heading = 'sections.home.discovery.pretend_heading' | t
                  if block.settings.text == 'Stories, roles and imagination'
                    assign play_card_text = 'sections.home.discovery.pretend_text' | t
                  endif
                when 'Active play'
                  assign play_card_heading = 'sections.home.discovery.active_heading' | t
                  if block.settings.text == 'Movement and family games'
                    assign play_card_text = 'sections.home.discovery.active_text' | t
                  endif
              endcase
            %}
            <a
              href="{{ block.settings.link | default: routes.all_products_collection_url }}"
              style="--discovery-card-color: {{ block.settings.background_color }};"
              {{ block.shopify_attributes }}
            >
              <span class="loemies-discovery__play-icon" aria-hidden="true">
                {% case block.settings.icon %}
                  {% when 'sensory' %}
                    <svg viewBox="0 0 32 32" fill="none"><path d="M6 19c4-8 8-12 12-12 5 0 8 5 8 10s-4 9-10 9c-5 0-8-2-10-7Z" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="15" r="3" fill="currentColor"/></svg>
                  {% when 'pretend' %}
                    <svg viewBox="0 0 32 32" fill="none"><path d="M7 25V12l9-6 9 6v13H7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M13 25v-7h6v7M11 14h2M19 14h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  {% when 'active' %}
                    <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="2"/><path d="m16 6 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                  {% else %}
                    <svg viewBox="0 0 32 32" fill="none"><path d="M7 23h8v-8H7v8Zm10 0h8v-8h-8v8Zm-5-10h8V5h-8v8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                {% endcase %}
              </span>
              <span>
                <strong>{{ play_card_heading }}</strong>
                {% if play_card_text != blank %}<small>{{ play_card_text }}</small>{% endif %}
              </span>
              <span class="loemies-discovery__arrow" aria-hidden="true">&rsaquo;</span>
            </a>
          {% endfor %}
        </nav>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .loemies-discovery {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .loemies-discovery__inner {
    width: min(100%, 67rem);
    margin-inline: auto;
    grid-column: 2;
  }

  .loemies-discovery__header {
    max-width: 46rem;
  }

  .loemies-discovery__eyebrow {
    margin: 0 0 0.5rem;
    color: #b04f38;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .loemies-discovery h2,
  .loemies-discovery h3,
  .loemies-discovery p {
    margin: 0;
  }

  .loemies-discovery h2 {
    color: #2b241f;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-weight: 900;
    line-height: 1.2;
  }

  .loemies-discovery__text {
    max-width: 52ch;
    margin-top: 0.5rem;
    color: #4c443c;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .loemies-discovery__groups {
    display: grid;
    margin-top: 1.5rem;
    gap: 1rem;
  }

  .loemies-discovery__group {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid #eadfd2;
    border-radius: 1rem;
    background: #ffffff;
    scroll-margin-top: 9rem;
  }

  .loemies-discovery__group-heading {
    margin-bottom: 0.85rem;
  }

  .loemies-discovery__group-heading h3 {
    color: #2b241f;
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.3;
  }

  .loemies-discovery__group-heading p {
    margin-top: 0.25rem;
    color: #665b52;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .loemies-discovery__age-links,
  .loemies-discovery__play-links {
    display: grid;
    gap: 0.75rem;
  }

  .loemies-discovery__age-links {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .loemies-discovery__age-links a:last-child:nth-child(odd) {
    min-height: 5.5rem;
    grid-column: 1 / -1;
  }

  .loemies-discovery__age-links a,
  .loemies-discovery__play-links a {
    position: relative;
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 0.85rem;
    background: var(--discovery-card-color);
    color: #2b241f;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .loemies-discovery__age-links a:hover,
  .loemies-discovery__play-links a:hover {
    border-color: currentcolor;
    transform: translateY(-0.1rem);
  }

  .loemies-discovery__age-links a:focus-visible,
  .loemies-discovery__play-links a:focus-visible {
    outline: 0.15rem solid currentcolor;
    outline-offset: 0.2rem;
  }

  .loemies-discovery__age-links a {
    display: grid;
    min-height: 7rem;
    align-content: center;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.9rem 1.8rem 0.9rem 0.9rem;
    text-align: center;
  }

  .loemies-discovery__age-links a > span:first-child {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    color: #2f6b4f;
    font-weight: 900;
    place-items: center;
  }

  .loemies-discovery__age-links strong,
  .loemies-discovery__play-links strong {
    font-size: 0.9rem;
    font-weight: 850;
    line-height: 1.25;
  }

  .loemies-discovery__play-links {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .loemies-discovery__play-links a {
    display: flex;
    min-height: 6.3rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 2rem 0.85rem 0.85rem;
  }

  .loemies-discovery__play-links small {
    display: block;
    margin-top: 0.15rem;
    color: #4c443c;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .loemies-discovery__play-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.82);
    place-items: center;
  }

  .loemies-discovery__play-icon svg {
    width: 1.35rem;
  }

  .loemies-discovery__arrow {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    font-size: 1.25rem;
    line-height: 1;
    transform: translateY(-50%);
  }

  @media (min-width: 48rem) {
    .loemies-discovery__groups {
      align-items: stretch;
      grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
    }
  }

  @media (max-width: 46.99rem) {
    .loemies-discovery__group {
      padding: 1rem;
    }

    .loemies-discovery__play-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .loemies-discovery__play-links a {
      min-height: 7.5rem;
      align-content: center;
      align-items: start;
      flex-direction: column;
      padding: 0.8rem 1.8rem 0.8rem 0.8rem;
    }
  }

  @media (max-width: 29.99rem) {
    .loemies-discovery__play-links small {
      display: none;
    }
  }

  @media (max-width: 21rem) {
    .loemies-discovery__age-links {
      gap: 0.5rem;
    }

    .loemies-discovery__age-links a {
      min-height: 6.5rem;
      padding-inline: 0.55rem 1.5rem;
    }

    .loemies-discovery__age-links strong {
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loemies-discovery__age-links a,
    .loemies-discovery__play-links a {
      transition: none;
    }

    .loemies-discovery__age-links a:hover,
    .loemies-discovery__play-links a:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Loemies toy finder",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find their kind of fun" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right toy" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Start with a minimum age or the way they love to play.</p>" },
    { "type": "header", "content": "Age links" },
    { "type": "text", "id": "age_heading", "label": "Heading", "default": "Start with minimum age" },
    { "type": "text", "id": "age_note", "label": "Guidance", "default": "Always check the product page for the maker’s full recommendation." },
    { "type": "text", "id": "first_age_badge", "label": "First badge", "default": "1+" },
    { "type": "text", "id": "first_age_label", "label": "First label", "default": "From 1 year" },
    { "type": "url", "id": "first_age_link", "label": "First link" },
    { "type": "color", "id": "first_age_color", "label": "First color", "default": "#F7DC8D" },
    { "type": "text", "id": "second_age_badge", "label": "Second badge", "default": "2+" },
    { "type": "text", "id": "second_age_label", "label": "Second label", "default": "From 2 years" },
    { "type": "url", "id": "second_age_link", "label": "Second link" },
    { "type": "color", "id": "second_age_color", "label": "Second color", "default": "#DCD2F0" },
    { "type": "text", "id": "third_age_badge", "label": "Third badge", "default": "3+" },
    { "type": "text", "id": "third_age_label", "label": "Third label", "default": "From 3 years" },
    { "type": "url", "id": "third_age_link", "label": "Third link" },
    { "type": "color", "id": "third_age_color", "label": "Third color", "default": "#BEDCF1" },
    { "type": "text", "id": "fourth_age_badge", "label": "Fourth badge", "default": "5+" },
    { "type": "text", "id": "fourth_age_label", "label": "Fourth label" },
    { "type": "url", "id": "fourth_age_link", "label": "Fourth link" },
    { "type": "color", "id": "fourth_age_color", "label": "Fourth color", "default": "#F5C8CF" },
    { "type": "header", "content": "Play links" },
    { "type": "text", "id": "play_heading", "label": "Heading", "default": "Choose a way to play" }
  ],
  "blocks": [
    {
      "type": "play_type",
      "name": "Play type",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fine-motor play" },
        { "type": "text", "id": "text", "label": "Description", "default": "Threading, sorting and building" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "fine_motor",
          "options": [
            { "value": "fine_motor", "label": "Fine motor" },
            { "value": "sensory", "label": "Sensory" },
            { "value": "pretend", "label": "Pretend" },
            { "value": "active", "label": "Active" }
          ]
        },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#F7DC8D" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loemies toy finder",
      "blocks": [
        { "type": "play_type", "settings": { "heading": "Fine-motor play", "text": "Threading, sorting and building", "icon": "fine_motor", "background_color": "#F7DC8D" } },
        { "type": "play_type", "settings": { "heading": "Sensory play", "text": "Touch, movement and discovery", "icon": "sensory", "background_color": "#BEDCF1" } },
        { "type": "play_type", "settings": { "heading": "Pretend play", "text": "Stories, roles and imagination", "icon": "pretend", "background_color": "#F5C8CF" } },
        { "type": "play_type", "settings": { "heading": "Active play", "text": "Movement and family games", "icon": "active", "background_color": "#C4E4C9" } }
      ]
    }
  ]
}
{% endschema %}
