{% liquid
  assign article_limit = section.settings.articles_per_page
  assign active_tag = current_tags.first
  # The `t` filter HTML-escapes its output, so raw setting branches are escaped
  # here and the localized variables are printed without a second escape.
  assign journal_eyebrow = section.settings.eyebrow | escape
  if section.settings.eyebrow == blank or section.settings.eyebrow == 'Ideas & inspiration'
    assign journal_eyebrow = 'blog.defaults.eyebrow' | t
  endif
  assign journal_intro = section.settings.intro | escape
  if section.settings.intro == blank or section.settings.intro == 'Thoughtful ideas for play, gifting and making everyday moments with little ones count.'
    assign journal_intro = 'blog.defaults.intro' | t
  endif
  assign journal_fallback_topic = section.settings.fallback_topic | escape
  if section.settings.fallback_topic == blank or section.settings.fallback_topic == 'Loemies journal'
    assign journal_fallback_topic = 'blog.defaults.topic' | t
  endif
%}

<section
  class="loemies-journal full-width"
  style="
    --journal-background: {{ section.settings.background_color }};
    --journal-card: {{ section.settings.card_color }};
    --journal-text: {{ section.settings.text_color }};
    --journal-accent: {{ section.settings.accent_color }};
    --journal-accent-soft: {{ section.settings.accent_soft_color }};
  "
>
  <div class="loemies-journal__inner">
    {% if section.settings.show_breadcrumbs %}
      <nav class="loemies-editorial__breadcrumb" aria-label="{{ 'general.accessibility.breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.accessibility.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ blog.title | escape }}</span>
      </nav>
    {% endif %}

    <header class="loemies-journal__header">
      <div>
        {% if journal_eyebrow != blank %}
          <p class="loemies-editorial__eyebrow">{{ journal_eyebrow }}</p>
        {% endif %}
        <h1>{{ blog.title | escape }}</h1>
      </div>

      <div class="loemies-journal__introduction">
        {% if journal_intro != blank %}
          <p>{{ journal_intro }}</p>
        {% endif %}
        <p class="loemies-journal__count">{{ 'blog.article_count' | t: count: blog.articles_count }}</p>
      </div>
    </header>

    {% if section.settings.show_tag_filter and blog.all_tags.size > 0 %}
      <nav class="loemies-journal__topics" aria-label="{{ 'blog.browse_topics' | t }}">
        <span class="loemies-journal__topics-label">{{ 'blog.browse_topics' | t }}</span>
        <div class="loemies-journal__topic-links">
          <a href="{{ blog.url }}"{% if active_tag == blank %} class="is-active" aria-current="page"{% endif %}>
            {{ 'blog.all_topics' | t }}
          </a>
          {% for tag in blog.all_tags limit: 10 %}
            <span{% if current_tags contains tag %} class="is-active"{% endif %}>{{ tag | link_to_tag: tag }}</span>
          {% endfor %}
        </div>
      </nav>
    {% endif %}

    {% paginate blog.articles by article_limit %}
      {% if blog.articles_count > 0 %}
        <div class="loemies-journal__grid">
          {% for article in blog.articles %}
            {% liquid
              assign card_tone_index = forloop.index0 | modulo: 4
              assign article_words = article.content | strip_html | split: ' ' | size
              assign reading_time = article_words | plus: 199 | divided_by: 200
              if reading_time < 1
                assign reading_time = 1
              endif
              assign image_loading = 'lazy'
              assign image_fetchpriority = 'auto'
              if forloop.first
                assign image_loading = 'eager'
                assign image_fetchpriority = 'high'
              endif
            %}

            <article class="loemies-journal-card{% if forloop.first %} loemies-journal-card--featured{% endif %} loemies-journal-card--tone-{{ card_tone_index }}">
              <a class="loemies-journal-card__link" href="{{ article.url }}">
                <div class="loemies-journal-card__media">
                  {% if article.image %}
                    {{ article.image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '320, 480, 640, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 1088px) 516px, (min-width: 768px) calc((100vw - 152px) / 2), calc(100vw - 34px)',
                        loading: image_loading,
                        fetchpriority: image_fetchpriority
                    }}
                  {% else %}
                    <span class="loemies-journal-card__motif" aria-hidden="true"></span>
                  {% endif %}
                </div>

                <div class="loemies-journal-card__content">
                  {% if article.tags.size > 0 %}
                    <p class="loemies-journal-card__topic">{{ article.tags.first | escape }}</p>
                  {% else %}
                    <p class="loemies-journal-card__topic">{{ journal_fallback_topic }}</p>
                  {% endif %}

                  <h2>{{ article.title | escape }}</h2>

                  {% if section.settings.show_excerpt %}
                    <p class="loemies-journal-card__excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
                    </p>
                  {% endif %}

                  <div class="loemies-journal-card__meta">
                    {{ article.published_at | time_tag: format: 'date' }}
                    {% if section.settings.show_author and article.author != blank %}
                      <span aria-hidden="true">·</span>
                      <span>{{ article.author | escape }}</span>
                    {% endif %}
                    {% if section.settings.show_read_time %}
                      <span aria-hidden="true">·</span>
                      <span>{{ 'blog.reading_time' | t: count: reading_time }}</span>
                    {% endif %}
                  </div>

                  <span class="loemies-journal-card__read-more">
                    {{ 'blog.read_article' | t }}
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="loemies-journal__empty">
          <span class="loemies-journal__empty-motif" aria-hidden="true"></span>
          <p class="loemies-editorial__eyebrow">{{ journal_eyebrow }}</p>
          <h2>{{ 'blog.empty_heading' | t }}</h2>
          <p>{{ 'blog.empty_text' | t }}</p>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="loemies-editorial__pagination" aria-label="{{ 'blog.pagination' | t }}">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.accessibility.previous_page' | t }}">←</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" aria-label="{{ 'general.accessibility.go_to_page' | t: page: part.title }}">{{ part.title }}</a>
            {% else %}
              <span{% if part.title == paginate.current_page %} class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.accessibility.next_page' | t }}">→</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Loemies blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ideas & inspiration" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Thoughtful ideas for play, gifting and making everyday moments with little ones count." },
    { "type": "text", "id": "fallback_topic", "label": "Fallback topic", "default": "Loemies journal" },
    { "type": "range", "id": "articles_per_page", "label": "Articles per page", "min": 3, "max": 12, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "show_tag_filter", "label": "Show topic filters", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show article excerpts", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show authors", "default": false },
    { "type": "checkbox", "id": "show_read_time", "label": "Show reading time", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F3EC" },
    { "type": "color", "id": "card_color", "label": "Cards", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B241F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B04F38" },
    { "type": "color", "id": "accent_soft_color", "label": "Soft accent", "default": "#F6E6DF" }
  ]
}
{% endschema %}
