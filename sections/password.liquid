{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password

  The only page the public can see pre-launch: a centered brand card with the
  Loemies logo treatment, a warm one-liner, the storefront password form, and
  a newsletter capture so curious visitors can leave their email.
{% endcomment %}

{% liquid
  assign display_wordmark = section.settings.wordmark
  if display_wordmark == blank
    assign display_wordmark = shop.name
  endif

  # The `t` filter HTML-escapes its output, so escape the raw branch here and
  # print these without a second escape. New keys fall back to hardcoded
  # English until they land in the locale files.
  assign password_heading = section.settings.heading | escape
  if section.settings.heading == blank or section.settings.heading == 'Something lovely is taking shape'
    assign password_heading = 'password.heading' | t
    if password_heading contains 'ranslation missing'
      assign password_heading = 'Something lovely is taking shape'
    endif
  endif

  assign password_text = section.settings.text | escape
  if section.settings.text == blank or section.settings.text == "We're filling the shelves with thoughtful wooden toys — we open soon."
    assign password_text = 'password.tagline' | t
    if password_text contains 'ranslation missing'
      assign password_text = "We're filling the shelves with thoughtful wooden toys — we open soon."
    endif
  endif
  if shop.password_message != blank
    assign password_text = shop.password_message | escape
  endif

  assign newsletter_heading = section.settings.newsletter_heading | escape
  if section.settings.newsletter_heading == blank or section.settings.newsletter_heading == 'Be the first to know when we open'
    assign newsletter_heading = 'password.newsletter_heading' | t
    if newsletter_heading contains 'ranslation missing'
      assign newsletter_heading = 'Be the first to know when we open'
    endif
  endif

  assign owner_question = 'password.owner_question' | t
  if owner_question contains 'ranslation missing'
    assign owner_question = 'Are you the store owner?'
  endif
  assign owner_link_label = 'password.owner_login' | t
  if owner_link_label contains 'ranslation missing'
    assign owner_link_label = 'Log in here'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block: 0;
  }
{% endstyle %}

<section class="loemies-password" aria-labelledby="PasswordHeading-{{ section.id }}">
  <div class="loemies-password__inner">
    <div class="loemies-password__card">
      <div class="loemies-password__brand" style="--logo-width: {{ section.settings.logo_width }}px;">
        {% if section.settings.logo != blank %}
          {% assign logo_alt = section.settings.logo.alt | default: display_wordmark %}
          {% assign logo_sizes = section.settings.logo_width | append: 'px' %}
          {{ section.settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'loemies-password__logo',
              widths: '120, 180, 240, 360, 480, 600',
              width: section.settings.logo_width,
              sizes: logo_sizes,
              alt: logo_alt
          }}
        {% else %}
          <span class="loemies-password__wordmark">{{ display_wordmark | escape }}</span>
        {% endif %}
      </div>

      <h1 id="PasswordHeading-{{ section.id }}">{{ password_heading }}</h1>
      <p class="loemies-password__text">{{ password_text }}</p>

      <div class="loemies-password__panel loemies-password__panel--access">
        <p class="loemies-password__panel-label">{{ 'password.title' | t }}</p>

        {% form 'storefront_password', class: 'loemies-password__form' %}
          {% if form.errors %}
            <div class="loemies-password__errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <label class="visually-hidden" for="PasswordInput-{{ section.id }}">{{ 'password.password' | t }}</label>
          <div class="loemies-password__controls">
            <input
              id="PasswordInput-{{ section.id }}"
              type="password"
              name="password"
              placeholder="{{ 'password.password' | t }}"
              autocomplete="current-password"
              required
            >
            <button type="submit">{{ 'password.enter' | t }}</button>
          </div>
        {% endform %}
      </div>

      {% if section.settings.show_newsletter %}
        <div class="loemies-password__panel loemies-password__panel--newsletter">
          <p class="loemies-password__panel-label">{{ newsletter_heading }}</p>

          {% form 'customer', class: 'loemies-password__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {% if form.posted_successfully? %}
              <p class="loemies-password__success" tabindex="-1">{{ 'sections.home.newsletter.success' | t }}</p>
            {% else %}
              {% if form.errors %}
                <div class="loemies-password__errors" role="alert">{{ form.errors | default_errors }}</div>
              {% endif %}

              <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'sections.home.newsletter.email_label' | t }}</label>
              <div class="loemies-password__controls">
                <input
                  id="NewsletterEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email | escape }}"
                  placeholder="{{ 'sections.home.newsletter.email_label' | t }}"
                  autocomplete="email"
                  autocapitalize="off"
                  required
                >
                <button type="submit">{{ 'sections.home.newsletter.button' | t }}</button>
              </div>
              <p class="loemies-password__note">{{ 'sections.home.newsletter.note' | t }}</p>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    <p class="loemies-password__meta">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
      <span>{{ owner_question }} <a href="/admin">{{ owner_link_label }}</a></span>
    </p>
  </div>
</section>

{% stylesheet %}
  .loemies-password {
    display: grid;
    min-height: 100svh;
    padding-block: clamp(1.5rem, 5vh, 3.5rem);
    place-items: center;
  }

  .loemies-password__inner {
    display: grid;
    width: 100%;
    justify-items: center;
    gap: 1.25rem;
  }

  .loemies-password__card {
    display: grid;
    width: min(100%, 27rem);
    padding: clamp(1.75rem, 5vw, 2.75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    justify-items: center;
    text-align: center;
  }

  .loemies-password__brand {
    display: inline-flex;
    max-width: min(var(--logo-width), 100%);
    align-items: center;
    color: var(--color-ink);
  }

  .loemies-password__logo {
    width: var(--logo-width);
    max-height: 4.25rem;
    object-fit: contain;
  }

  .loemies-password__wordmark {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-heading--family);
    font-size: 1.65rem;
    font-weight: var(--font-heading--weight);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .loemies-password__wordmark::before {
    width: 1.6rem;
    height: 1rem;
    flex: 0 0 auto;
    background: var(--color-brand);
    border-radius: 999px;
    box-shadow: 0.7rem -0.45rem 0 -0.25rem var(--color-sand);
    content: '';
  }

  .loemies-password__card h1 {
    margin-top: 1.4rem;
    font-size: clamp(1.55rem, 5vw, 1.95rem);
    font-weight: 900;
  }

  .loemies-password__text {
    max-width: 38ch;
    margin-top: 0.7rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .loemies-password__panel {
    width: 100%;
    padding: 1.1rem 1.15rem 1.25rem;
    margin-top: 1.4rem;
    border-radius: var(--radius-small);
    text-align: start;
  }

  .loemies-password__panel--access {
    background: var(--color-cream);
  }

  .loemies-password__panel--newsletter {
    background: var(--color-blush);
  }

  .loemies-password__panel-label {
    margin: 0 0 0.75rem;
    color: var(--color-ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .loemies-password__controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
  }

  .loemies-password__controls input {
    min-width: 0;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .loemies-password__controls input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .loemies-password__controls button {
    border-radius: 999px;
  }

  .loemies-password__note {
    margin-top: 0.6rem;
    color: var(--color-body);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .loemies-password__success {
    padding: 0.8rem 1rem;
    border-radius: var(--radius-small);
    background: var(--color-surface);
    font-weight: 750;
  }

  .loemies-password__errors {
    margin-bottom: 0.75rem;
    color: #8c2f3b;
    font-size: 0.85rem;
  }

  .loemies-password__errors ul {
    padding-inline-start: 1.1rem;
    margin: 0;
  }

  .loemies-password__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding-inline: 1rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    text-align: center;
    column-gap: 1rem;
    row-gap: 0.2rem;
  }

  .loemies-password__meta a {
    color: inherit;
    font-weight: 750;
  }

  @media (max-width: 26rem) {
    .loemies-password__controls {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Text wordmark",
      "info": "Used when no logo image is selected. Defaults to the shop name."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something lovely is taking shape"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "The password message from Shopify admin preferences takes priority when set.",
      "default": "We're filling the shelves with thoughtful wooden toys — we open soon."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Be the first to know when we open"
    }
  ]
}
{% endschema %}
