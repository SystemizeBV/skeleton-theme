{% liquid
  # The `t` filter HTML-escapes its output, so raw setting branches are escaped
  # here and the localized variables are printed without a second escape.
  assign play_eyebrow = section.settings.eyebrow | escape
  if section.settings.eyebrow == blank or section.settings.eyebrow == 'Find their kind of fun'
    assign play_eyebrow = 'sections.home.discovery.eyebrow' | t
  endif
  assign play_heading = section.settings.heading | escape
  if section.settings.heading == blank or section.settings.heading == 'Shop by play'
    assign play_heading = 'sections.play_navigation.heading' | t
  endif
  assign play_text = section.settings.text
  if play_text == blank or play_text == '<p>Start with how they love to explore.</p>'
    capture play_text
      echo '<p>'
      echo 'sections.play_navigation.text' | t
      echo '</p>'
    endcapture
  endif
%}

<section id="shop-by-play" class="loemies-play full-width" aria-labelledby="LoemiesPlay-{{ section.id }}">
  <div class="loemies-play__inner">
    <header class="loemies-home-heading">
      {% if play_eyebrow != blank %}
        <p class="loemies-home-heading__eyebrow">{{ play_eyebrow }}</p>
      {% endif %}
      <h2 id="LoemiesPlay-{{ section.id }}">{{ play_heading }}</h2>
      {% if play_text != blank %}
        <div class="loemies-home-heading__text">{{ play_text }}</div>
      {% endif %}
    </header>

    <nav class="loemies-play__rail" aria-label="{{ play_heading }}">
      {% for block in section.blocks %}
        {% liquid
          assign play_card_heading = block.settings.heading | escape
          assign play_card_text = block.settings.text | escape
          case block.settings.icon
            when 'fine_motor'
              if block.settings.heading == blank or block.settings.heading == 'Fine-motor play'
                assign play_card_heading = 'sections.home.discovery.fine_motor_heading' | t
              endif
              if block.settings.text == blank or block.settings.text == 'Threading, sorting and building'
                assign play_card_text = 'sections.home.discovery.fine_motor_text' | t
              endif
            when 'sensory'
              if block.settings.heading == blank or block.settings.heading == 'Sensory play'
                assign play_card_heading = 'sections.home.discovery.sensory_heading' | t
              endif
              if block.settings.text == blank or block.settings.text == 'Touch, movement and discovery'
                assign play_card_text = 'sections.home.discovery.sensory_text' | t
              endif
            when 'pretend'
              if block.settings.heading == blank or block.settings.heading == 'Pretend play'
                assign play_card_heading = 'sections.home.discovery.pretend_heading' | t
              endif
              if block.settings.text == blank or block.settings.text == 'Stories, roles and imagination'
                assign play_card_text = 'sections.home.discovery.pretend_text' | t
              endif
            when 'active'
              if block.settings.heading == blank or block.settings.heading == 'Active play'
                assign play_card_heading = 'sections.home.discovery.active_heading' | t
              endif
              if block.settings.text == blank or block.settings.text == 'Movement and family games'
                assign play_card_text = 'sections.home.discovery.active_text' | t
              endif
          endcase
        %}
        <a
          class="loemies-play-card"
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          style="--loemies-play-color: {{ block.settings.background_color }};"
          {{ block.shopify_attributes }}
        >
          <span class="loemies-play-card__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'sensory' %}
                <svg viewBox="0 0 32 32" fill="none"><path d="M6 19c4-8 8-12 12-12 5 0 8 5 8 10s-4 9-10 9c-5 0-8-2-10-7Z" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="15" r="3" fill="currentColor"/></svg>
              {% when 'pretend' %}
                <svg viewBox="0 0 32 32" fill="none"><path d="M7 25V12l9-6 9 6v13H7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M13 25v-7h6v7M11 14h2M19 14h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              {% when 'active' %}
                <svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="2"/><path d="m16 6 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              {% else %}
                <svg viewBox="0 0 32 32" fill="none"><path d="M7 23h8v-8H7v8Zm10 0h8v-8h-8v8Zm-5-10h8V5h-8v8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            {% endcase %}
          </span>
          <span>
            <strong>{{ play_card_heading }}</strong>
            {% if play_card_text != blank %}<small>{{ play_card_text }}</small>{% endif %}
          </span>
          <span class="loemies-play-card__arrow" aria-hidden="true">&rsaquo;</span>
        </a>
      {% endfor %}
    </nav>
  </div>
</section>

{% stylesheet %}
  .loemies-play {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .loemies-play__inner {
    width: min(100%, 67rem);
    margin-inline: auto;
    grid-column: 2;
  }

  .loemies-play__rail {
    display: grid;
    margin-top: 1.5rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .loemies-play-card {
    position: relative;
    display: flex;
    min-height: 7rem;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 2.25rem 1rem 1rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: var(--loemies-play-color);
    color: #2b241f;
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .loemies-play-card:hover {
    border-color: currentcolor;
    transform: translateY(-0.125rem);
  }

  .loemies-play-card:focus-visible {
    outline: 0.15rem solid currentcolor;
    outline-offset: 0.2rem;
  }

  .loemies-play-card__icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.82);
    place-items: center;
  }

  .loemies-play-card__icon svg {
    width: 1.5rem;
  }

  .loemies-play-card strong,
  .loemies-play-card small {
    display: block;
  }

  .loemies-play-card strong {
    font-size: 0.95rem;
    font-weight: 850;
    line-height: 1.25;
  }

  .loemies-play-card small {
    margin-top: 0.2rem;
    color: #4c443c;
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .loemies-play-card__arrow {
    position: absolute;
    right: 0.9rem;
    font-size: 1.3rem;
  }

  @media (max-width: 61.99rem) {
    .loemies-play__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 46.99rem) {
    .loemies-play__rail {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .loemies-play-card {
      min-height: 6.75rem;
      padding-left: 0.85rem;
    }
  }

  @media (max-width: 27.99rem) {
    .loemies-play-card small {
      display: none;
    }
  }

  @media (max-width: 21.99rem) {
    .loemies-play__rail {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loemies-play-card {
      transition: none;
    }

    .loemies-play-card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Loemies shop by play",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find their kind of fun" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by play" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Start with how they love to explore.</p>" }
  ],
  "blocks": [
    {
      "type": "play_type",
      "name": "Play type",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fine-motor play" },
        { "type": "text", "id": "text", "label": "Description", "default": "Threading, sorting and building" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "fine_motor",
          "options": [
            { "value": "fine_motor", "label": "Fine motor" },
            { "value": "sensory", "label": "Sensory" },
            { "value": "pretend", "label": "Pretend" },
            { "value": "active", "label": "Active" }
          ]
        },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#F7DC8D" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loemies shop by play",
      "blocks": [
        { "type": "play_type", "settings": { "heading": "Fine-motor play", "text": "Threading, sorting and building", "icon": "fine_motor", "background_color": "#F7DC8D" } },
        { "type": "play_type", "settings": { "heading": "Sensory play", "text": "Touch, movement and discovery", "icon": "sensory", "background_color": "#BEDCF1" } },
        { "type": "play_type", "settings": { "heading": "Pretend play", "text": "Stories, roles and imagination", "icon": "pretend", "background_color": "#F5C8CF" } },
        { "type": "play_type", "settings": { "heading": "Active play", "text": "Movement and family games", "icon": "active", "background_color": "#C4E4C9" } }
      ]
    }
  ]
}
{% endschema %}
