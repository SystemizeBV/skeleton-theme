{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<article class="shopify-policy__container content-page" aria-labelledby="ContentPageTitle-{{ section.id }}">
  <header class="shopify-policy__title">
    <h1 id="ContentPageTitle-{{ section.id }}">{{ page.title | escape }}</h1>
  </header>

  <div class="shopify-policy__body">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
