{% doc %}
  Renders the hero image or Loemies' rainbow artwork.

  @example
  {% content_for 'block', type: 'loemies-hero-image', id: 'media' %}
{% enddoc %}

{% liquid
  assign hero_image_loading = 'lazy'
  assign hero_fetch_priority = 'auto'
  assign hero_image_preload = false
  assign hero_product = block.settings.featured_product
  assign hero_image = block.settings.image
  # The `t` filter HTML-escapes its output, so raw setting branches are escaped
  # here and the localized variables are printed without a second escape.
  assign hero_product_label = block.settings.product_label | escape
  assign hero_fallback_alt = block.settings.fallback_alt | escape

  if block.settings.product_label == 'Featured pick'
    assign hero_product_label = 'sections.home.hero.featured_pick' | t
  endif
  if block.settings.fallback_alt == 'A playful rainbow with a cloud and star'
    assign hero_fallback_alt = 'sections.home.hero.fallback_alt' | t
  endif

  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_image
  endif

  assign hero_alt = hero_image.alt | default: block.settings.alt_text
  if hero_alt == blank and hero_product != blank
    assign hero_alt = hero_product.title
  endif

  if section.index == 1
    assign hero_image_loading = 'eager'
    assign hero_fetch_priority = 'high'
    assign hero_image_preload = true
  endif
%}

<figure class="loemies-hero-media{% if hero_product != blank %} is-product{% endif %}" {{ block.shopify_attributes }}>
  {% if hero_image != blank %}
    {% if hero_product != blank %}
      <a class="loemies-hero-media__image-link" href="{{ hero_product.url }}" aria-label="{{ 'products.card.view_product' | t }}: {{ hero_product.title | escape }}">
    {% endif %}
    {{ hero_image
      | image_url: width: 1200
      | image_tag:
        class: 'loemies-hero-media__image',
        widths: '128, 192, 256, 320, 352, 480, 640, 704, 800, 960, 1200',
        sizes: '(min-width: 960px) 21rem, (min-width: 640px) 34vw, 6.5rem',
        loading: hero_image_loading,
        fetchpriority: hero_fetch_priority,
        preload: hero_image_preload,
        alt: hero_alt
    }}
    {% if hero_product != blank %}
      </a>
      {% if block.settings.show_product_details %}
        <figcaption class="loemies-hero-product">
          <span class="loemies-hero-product__label">{{ hero_product_label }}</span>
          <a href="{{ hero_product.url }}">{{ hero_product.title | escape }}</a>
          {% if hero_product.tags contains 'FSC Wood' %}
            <span class="loemies-hero-product__detail">{{ 'products.card.fsc_wood' | t }}</span>
          {% endif %}
          <strong>{{ hero_product.price | money }}</strong>
        </figcaption>
      {% endif %}
    {% endif %}
  {% else %}
    <svg
      class="loemies-hero-art"
      viewBox="0 0 360 292.5"
      {% if hero_fallback_alt != blank %}
        role="img"
        aria-label="{{ hero_fallback_alt }}"
      {% else %}
        aria-hidden="true"
      {% endif %}
    >
      <circle cx="62" cy="104" r="22" fill="#FFFFFF"/>
      <circle cx="112" cy="91" r="5" fill="#E2A33C"/>
      <circle cx="81" cy="212" r="6" fill="#FFFFFF"/>
      <circle cx="303" cy="224" r="6" fill="#2F6B4F"/>
      <path d="m164 66 7 15 16 2-12 11 3 16-14-8-15 8 3-16-11-11 16-2 7-15Z" fill="#2F6B4F"/>
      <path d="M253 90c2-17 15-30 32-30 18 0 32 14 33 32 12 0 22 10 22 22s-10 22-22 22h-68c-13 0-23-10-23-23 0-12 9-22 21-23h5Z" fill="#FFFFFF"/>
      <path d="M41 272c0-73 59-132 132-132s132 59 132 132" fill="none" stroke="#2F6B4F" stroke-width="17" stroke-linecap="round"/>
      <path d="M70 272c0-57 46-103 103-103s103 46 103 103" fill="none" stroke="#FFFFFF" stroke-width="17" stroke-linecap="round"/>
      <path d="M99 272c0-41 33-74 74-74s74 33 74 74" fill="none" stroke="#FFFFFF" stroke-width="17" stroke-linecap="round"/>
      <path d="M127 272c0-25 21-46 46-46s46 21 46 46" fill="none" stroke="#E2A33C" stroke-width="17" stroke-linecap="round"/>
    </svg>
  {% endif %}
</figure>

{% stylesheet %}
  .loemies-hero-media {
    position: relative;
    display: grid;
    width: 100%;
    max-width: 26rem;
    min-height: 0;
    margin: 0 auto;
    place-items: end center;
  }

  .loemies-hero-media__image-link {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: calc(var(--loemies-hero-radius, 1rem) * 0.75);
    color: inherit;
  }

  .loemies-hero-media__image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    height: 100%;
    max-height: 26rem;
    border-radius: calc(var(--loemies-hero-radius, 1rem) * 0.75);
    background: #eef0e9;
    object-fit: cover;
    /* Crops the thin white pillar bars that supplier stills carry. */
    transform: scale(1.12);
    transition: transform 180ms ease;
  }

  .loemies-hero-media__image-link:hover .loemies-hero-media__image {
    transform: scale(1.15);
  }

  .loemies-hero-product {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    display: grid;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(234, 223, 210, 0.9);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 0.35rem 1rem rgba(43, 36, 31, 0.12);
    color: #2b241f;
    gap: 0.1rem;
  }

  .loemies-hero-product__label {
    color: #b04f38;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .loemies-hero-product a {
    display: -webkit-box;
    overflow: hidden;
    color: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .loemies-hero-product a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .loemies-hero-product strong {
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .loemies-hero-product__detail {
    color: #665b52;
    font-size: 0.68rem;
    font-weight: 750;
  }

  .loemies-hero-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  @media (max-width: 39.99rem) {
    .loemies-hero-media {
      max-width: 14.5rem;
    }

    .loemies-hero-media.is-product {
      max-width: none;
      overflow: hidden;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      border: 1px solid rgba(234, 223, 210, 0.9);
      border-radius: calc(var(--loemies-hero-radius, 1rem) * 0.75);
      background: #ffffff;
      box-shadow: 0 0.35rem 1rem rgba(43, 36, 31, 0.1);
      place-items: stretch;
    }

    .loemies-hero-media.is-product .loemies-hero-media__image-link {
      border-radius: 0;
    }

    .loemies-hero-media.is-product .loemies-hero-media__image {
      height: 100%;
      max-height: none;
      border-radius: 0;
    }

    .loemies-hero-media.is-product .loemies-hero-product {
      position: static;
      align-content: center;
      padding: 0.7rem 0.8rem;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loemies-hero-media__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Loemies hero artwork",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Overrides the featured product image when selected."
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "checkbox",
      "id": "show_product_details",
      "label": "Show product details",
      "default": true
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Product label",
      "default": "Featured pick"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "info": "Used when the selected image has no alt text."
    },
    {
      "type": "text",
      "id": "fallback_alt",
      "label": "Fallback artwork description",
      "default": "A playful rainbow with a cloud and star"
    }
  ],
  "presets": [
    {
      "name": "Loemies hero artwork"
    }
  ]
}
{% endschema %}
