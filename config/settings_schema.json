[
  {
    "name": "theme_info",
    "theme_name": "Loemies",
    "theme_version": "0.1.0",
    "theme_author": "Loemies",
    "theme_documentation_url": "https://github.com/Shopify/skeleton-theme",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Brand fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "nunito_n9",
        "label": "Heading font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "nunito_n4",
        "label": "Body font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          {
            "value": "80rem",
            "label": "Comfortable"
          },
          {
            "value": "90rem",
            "label": "Generous"
          },
          {
            "value": "110rem",
            "label": "Wide"
          }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "Page margin",
        "default": 64
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 32,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section spacing",
        "default": 64
      },
      {
        "type": "header",
        "content": "Corners"
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 16
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 40
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Input corner radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Loemies palette",
    "settings": [
      {
        "type": "paragraph",
        "content": "The warm neutral base, terracotta brand color, and gentle pastels mirror the Loemies storefront."
      },
      {
        "type": "color",
        "id": "color_cream",
        "default": "#F7F3EC",
        "label": "Cream background"
      },
      {
        "type": "color",
        "id": "color_blush",
        "default": "#F5C8CF",
        "label": "Blush"
      },
      {
        "type": "color",
        "id": "color_lavender",
        "default": "#DCD2F0",
        "label": "Lavender"
      },
      {
        "type": "color",
        "id": "color_sage",
        "default": "#C4E4C9",
        "label": "Sage"
      },
      {
        "type": "color",
        "id": "color_butter",
        "default": "#F7DC8D",
        "label": "Butter"
      },
      {
        "type": "color",
        "id": "color_ink",
        "default": "#2B241F",
        "label": "Dark ink"
      },
      {
        "type": "color",
        "id": "color_plum",
        "default": "#B04F38",
        "label": "Terracotta brand"
      }
    ]
  },
  {
    "name": "Brand and SEO",
    "settings": [
      {
        "type": "text",
        "id": "site_name",
        "label": "Storefront name",
        "default": "Loemies",
        "info": "Used in page titles and social previews when the Shopify store name is not ready."
      },
      {
        "type": "text",
        "id": "homepage_meta_title",
        "label": "Homepage title",
        "default": "Loemies | Thoughtful toys for little ones"
      },
      {
        "type": "textarea",
        "id": "homepage_meta_description",
        "label": "Homepage description",
        "default": "Discover thoughtfully chosen toys, playroom favorites and gifts for curious little ones."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "social_sharing_image",
        "label": "Default social sharing image",
        "info": "Recommended size: 1200 × 630 px."
      }
    ]
  },
  {
    "name": "Store promises",
    "settings": [
      {
        "type": "paragraph",
        "content": "These values keep shipping and return promises consistent across the header, homepage, product pages, and cart. Only enable free-shipping messaging after the checkout rate has been verified for every eligible shipping profile."
      },
      {
        "type": "checkbox",
        "id": "free_shipping_enabled",
        "label": "Advertise free shipping",
        "info": "Turn this on only when checkout applies the threshold to every eligible product and destination.",
        "default": false
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": "€49"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold_amount",
        "label": "Free shipping threshold (amount in store currency)",
        "default": 49
      },
      {
        "type": "range",
        "id": "return_window_days",
        "label": "Return window",
        "min": 7,
        "max": 60,
        "step": 1,
        "default": 30
      },
      {
        "type": "range",
        "id": "max_items_per_product",
        "label": "Maximum quantity per product",
        "info": "Prevents accidental consumer-size orders when a supplier allows selling beyond tracked inventory.",
        "min": 1,
        "max": 25,
        "step": 1,
        "default": 10
      }
    ]
  }
]
